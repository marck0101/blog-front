{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.clarity.ms https://connect.facebook.net; connect-src 'self' https://api.blog.marck0101.com.br https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://www.facebook.com https://firebasestorage.googleapis.com https://storage.googleapis.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; report-uri https://api.blog.marck0101.com.br/api/csp-report" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/skins/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/blog", "permanent": true },
    { "source": "/feed", "destination": "/rss.xml", "permanent": true },
    { "source": "/feed.xml", "destination": "/rss.xml", "permanent": true },
    { "source": "/rss", "destination": "/rss.xml", "permanent": true },
    { "source": "/politica-de-privacidade", "destination": "/privacidade", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.blog.marck0101.com.br/sitemap.xml" },
    { "source": "/rss.xml", "destination": "https://api.blog.marck0101.com.br/rss.xml" },
    { "source": "/llms.txt", "destination": "https://api.blog.marck0101.com.br/llms.txt" },
    { "source": "/llms-full.txt", "destination": "https://api.blog.marck0101.com.br/llms-full.txt" },
    { "source": "/indexnow-key.txt", "destination": "https://api.blog.marck0101.com.br/indexnow-key.txt" },
    { "source": "/blog", "destination": "/api/prerender" },
    { "source": "/blog/:slug", "destination": "/api/prerender?slug=:slug" },
    { "source": "/seasons", "destination": "/api/prerender?page=seasons" },
    { "source": "/seasons/:slug", "destination": "/api/prerender?season=:slug" },
    { "source": "/privacidade", "destination": "/index.html" },
    { "source": "/favoritos", "destination": "/index.html" },
    { "source": "/cancelar-inscricao", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
