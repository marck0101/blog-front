{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.blog.marck0101.com.br/sitemap.xml" },
    { "source": "/rss.xml", "destination": "https://api.blog.marck0101.com.br/rss.xml" },
    { "source": "/llms.txt", "destination": "https://api.blog.marck0101.com.br/llms.txt" },
    { "source": "/blog", "destination": "/api/prerender" },
    { "source": "/blog/:slug", "destination": "/api/prerender?slug=:slug" },
    { "source": "/seasons", "destination": "/api/prerender?page=seasons" },
    { "source": "/seasons/:slug", "destination": "/api/prerender?season=:slug" },
    { "source": "/((?!assets/)(?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
